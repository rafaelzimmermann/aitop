# aitop config — copy to ~/.config/aitop/.env (or ./.env) and chmod 600.
# Every value is optional: unset ones fall back to sensible defaults under $HOME.

REFRESH_SECONDS=5
#PROVIDERS=codex,claude,copilot,z.ai,openrouter,deepseek     # panels to show, in order
#AITOP_CACHE_DIR=${HOME}/.cache/aitop             # panel snapshots + pricing cache (owner-only 0700)
#PRICING_CACHE_HOURS=24
#PACE_TRIGGER=10                            # percent delta that counts as ahead/behind
#AITOP_REDACT=0                             # 1 = hide email + key prefixes (also: --redact)
#AITOP_HISTORY=0                            # 1 = sparkline over 7 daily buckets (also: --history)

# codex — token is read from CODEX_AUTH_FILE (JSON with tokens.access_token),
# or set CODEX_ACCESS_TOKEN directly.
#CODEX_AUTH_FILE=${HOME}/.codex/auth.json
#CODEX_ACCESS_TOKEN=
#CODEX_BASE_URL=https://chatgpt.com/backend-api
#CODEX_INSTALLATION_ID=            # auto-read from ~/.codex/installation_id
# claude — GET {ANTHROPIC_BASE_URL}/api/oauth/usage; requires Claude Code's OAuth
# credentials (~/.claude/.credentials.json). Plain sk- API keys are not accepted by
# this endpoint; without OAuth creds the row falls back to local session accounting.
#CLAUDE_CREDENTIALS_FILE=${HOME}/.claude/.credentials.json
#ANTHROPIC_BASE_URL=https://api.anthropic.com

# copilot — GET {GITHUB_API_BASE_URL}/copilot_internal/user
#GITHUB_TOKEN=                      # gh auth token, gh auth token env, or ~/.config/gh/oauth_token
#GITHUB_API_BASE_URL=https://api.github.com

# z.ai — live quota API first; these assumed caps apply to local fallback accounting.
# Tune fallback caps to your plan.
#ZAI_API_KEY=
#ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
#ZAI_LIMIT_5H=200000
#ZAI_LIMIT_DAY=1000000
#ZAI_LIMIT_WEEK=5000000
#ZAI_LIMIT_RPM=30

# openrouter
#OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OR_BUDGET_DAY=                          # optional USD budgets; pace on calendar rows
#OR_BUDGET_WEEK=                         # needs a budget, not the lifetime balance
#OR_BUDGET_MONTH=

# deepseek — GET {DEEPSEEK_BASE_URL}/user/balance; the official balance is a lifetime
# account balance, so the bar only appears when a spending budget (OR_BUDGET_MONTH) is set.
#DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=https://api.deepseek.com

# local session logs (sparkline + z.ai accounting)
#CODEX_SESSION_DIR=${HOME}/.codex/sessions
#PI_SESSION_DIR=${HOME}/.pi/agent/sessions

# local inference engines (enable with PROVIDERS=strata,ollama)
#STRATA_BASE_URL=http://127.0.0.1:8081
#OLLAMA_BASE_URL=http://127.0.0.1:11434
